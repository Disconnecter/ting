<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Apple Events: the Finder and browser context of micro-apps (the hardened runtime needs it). -->
    <key>com.apple.security.automation.apple-events</key><true/>
    <!-- Calendars: My Schedule reads events through EventKit. Without it the hardened runtime
         refuses the access request silently, and macOS never shows its prompt. -->
    <key>com.apple.security.personal-information.calendars</key><true/>
</dict>
</plist>
