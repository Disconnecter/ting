# Release facts of Ting for the shared kit in Scripts/release (see Scripts/release/README.md).
APP_NAME=Ting
APP_EXECUTABLE=Ting
BUNDLE_ID=io.bobuk.ting
ARCHIVE_PREFIX=Ting
CHECKSUMS_FILE=SHA256SUMS.txt
INSTALL_DIR=/Applications
GITHUB_REPO=bobuk-io/ting
LANDING_SLUG=ting
SPARKLE_ACCOUNT=io.bobuk.ting
SPARKLE_PUBLIC_KEY=AJCnH5OGe+uet2nuKtN2kzn5nxrCHoGo85K6b3OabA4=
# Ting 0.6.1 and older read the feed from the latest GitHub release.
GITHUB_APPCAST=1
HOMEBREW_CASK=ting
TEST_ARGS=--no-parallel
VERSION_SWIFT_FILE=Sources/TingCore/TingVersion.swift
VERSION_SWIFT_PREFIX='marketing = "'
BUNDLE_CHECK=Scripts/check_bundle.swift
EXTRA_TESTS='bash Vendor/BobukKit/Scripts/check-vendor.sh'
# Packaging with Scripts/release/package.sh (see Scripts/release/README.md, "Packaging").
PACKAGE_HELPERS=ting-micro:MacOS:io.bobuk.ting.micro
PACKAGE_RESOURCES="LICENSE THIRD_PARTY_NOTICES.md docs/micro-apps/FORMAT.md docs/CONFIGURING.md"
